GEMINI_API_KEY=
# Cheapest current model by default; override with any model id from
# `client.models.list()` (e.g. a specific pinned version instead of the
# auto-updating "-latest" alias).
GEMINI_MODEL=gemini-flash-lite-latest

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: pin an existing tracker spreadsheet instead of auto-creating one
GOOGLE_SHEETS_SPREADSHEET_ID=

SLACK_BOT_TOKEN=

DEMO_MODE=true

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
